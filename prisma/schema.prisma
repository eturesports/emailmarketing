// Eture Mailer — esquema de datos
//
// Provider por defecto: SQLite (cero configuración, ideal para self-hosting).
// Para migrar a PostgreSQL basta con cambiar `provider = "postgresql"` aquí y
// apuntar DATABASE_URL a tu instancia: no se usan enums nativos ni arrays, así
// que el esquema es compatible con ambos motores sin más cambios.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuarios de Google Workspace
// ---------------------------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  googleId String  @unique
  email    String  @unique
  name     String?
  imageUrl String?

  // Rol dentro de la plataforma: OWNER | ADMIN | MEMBER (ver lib/constants.ts)
  role     String  @default("MEMBER")
  isActive Boolean @default(true)

  // Credenciales OAuth de Gmail. Los tokens se guardan cifrados (AES-256-GCM),
  // ver lib/crypto.ts. Nunca se exponen al cliente.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  grantedScopes  String?

  signatureHtml String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  campaigns Campaign[]
  imports   ImportJob[]
  senders   Sender[]

  @@index([email])
}

/// Una identidad de envío: la dirección desde la que sale el correo y por qué
/// vía sale.
///
/// Se separa de `User` a propósito. Un usuario es alguien que entra en la
/// plataforma; un remitente es una dirección que envía, y no son lo mismo:
///   - Una cuenta de Google puede tener varios alias «enviar como», y cada uno
///     es un remitente distinto con su propia identidad.
///   - Un remitente de Resend no necesita cuenta de Google: le basta con estar
///     en un dominio verificado.
///   - Una persona puede dejar el equipo sin que sus campañas pierdan el
///     remitente con el que salieron.
model Sender {
  id String @id @default(cuid())

  /// Nombre interno para distinguirlo en las listas ("Marketing", "Prensa").
  label     String
  fromEmail String  @unique
  fromName  String?
  replyTo   String?

  /// GMAIL_API | SMTP_RELAY | RESEND (ver lib/constants.ts).
  transport String @default("GMAIL_API")

  /// Cuenta de Google que autoriza el envío. Obligatoria en GMAIL_API y
  /// SMTP_RELAY, porque el token OAuth y la cuota son suyos; nula en RESEND.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Credenciales del relay SMTP. La contraseña es una «contraseña de
  /// aplicación» de Google y se guarda cifrada.
  smtpUser     String?
  smtpPassword String?

  isActive Boolean @default(true)

  /// Tope propio, por debajo del límite del proveedor, para dejar margen al
  /// correo del día a día de la cuenta.
  dailyQuota      Int @default(1500)
  sendRatePerHour Int @default(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignsOwned  Campaign[]
  campaignSlots   CampaignSender[]
  recipients      Recipient[]
  sequenceSenders SequenceStep[]

  @@index([transport])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Contactos y listas
// ---------------------------------------------------------------------------

model Contact {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String?
  lastName  String?
  company   String?
  jobTitle  String?
  phone     String?
  country   String?
  language  String?

  // Campos personalizados libres importados del CSV/Excel, como objeto JSON
  // serializado: { "equipo": "Valorant", "tier": "Gold" }
  customFields String @default("{}")

  // SUBSCRIBED | UNSUBSCRIBED | BOUNCED | COMPLAINED (ver lib/constants.ts)
  status String @default("SUBSCRIBED")
  source String @default("manual") // manual | import | api

  /// Resultado de la comprobación de la dirección, antes de enviarle nada.
  /// UNKNOWN | VALID | RISKY | INVALID (ver lib/verify.ts).
  verification       String    @default("UNKNOWN")
  verificationReason String?
  verifiedAt         DateTime?

  unsubscribeToken String @unique @default(cuid())

  notes          String?
  lastSentAt     DateTime?
  bouncedAt      DateTime?
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ListMembership[]
  recipients  Recipient[]
  events      Event[]

  @@index([status])
  @@index([verification])
  @@index([createdAt])
}

model ContactList {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#22d3ee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   ListMembership[]
  campaignLists CampaignList[]
}

model ListMembership {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Plantillas
// ---------------------------------------------------------------------------

model Template {
  id          String  @id @default(cuid())
  name        String
  subject     String  @default("")
  html        String  @default("")
  previewText String?
  category    String  @default("General")
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

// ---------------------------------------------------------------------------
// Campañas
// ---------------------------------------------------------------------------

model Campaign {
  id          String  @id @default(cuid())
  name        String
  subject     String  @default("")
  html        String  @default("")
  previewText String?

  // DRAFT | SCHEDULED | SENDING | PAUSED | SENT | FAILED
  status String @default("DRAFT")

  /// Remitente por defecto de la campaña. Si no se elige un grupo explícito,
  /// es el único que envía.
  senderId String
  sender   Sender @relation(fields: [senderId], references: [id])

  /// Quién la creó, para el histórico. No influye en el envío.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  fromName String?
  replyTo  String?

  trackOpens         Boolean @default(true)
  trackClicks        Boolean @default(true)
  includeUnsubscribe Boolean @default(true)

  scheduledAt     DateTime?
  sendRatePerHour Int       @default(300)

  // Contadores desnormalizados para pintar el dashboard sin agregaciones caras
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)
  openCount       Int @default(0) // aperturas únicas
  clickCount      Int @default(0) // clics únicos
  unsubCount      Int @default(0)
  bounceCount     Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists      CampaignList[]
  senders    CampaignSender[]
  steps      SequenceStep[]
  recipients Recipient[]
  events     Event[]

  @@index([status])
  @@index([scheduledAt])
}

/// Cuentas que se reparten el envío de una campaña.
///
/// El límite de Google es **por cuenta**, así que repartir una campaña entre
/// varias cuentas del dominio multiplica el techo diario sin salirse de
/// Google Workspace.
model CampaignSender {
  campaignId String
  senderId   String
  addedAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@id([campaignId, senderId])
  @@index([senderId])
}

model CampaignList {
  campaignId String
  listId     String

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list     ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
}

/// Un mensaje concreto dirigido a un contacto: el envío inicial de una campaña
/// o uno de sus seguimientos. Es a la vez la cola de envío y el registro de
/// resultados de ese mensaje.
model Recipient {
  id         String @id @default(cuid())
  campaignId String
  contactId  String

  /// Paso de la secuencia al que corresponde. Nulo en el envío inicial.
  stepId String?
  step   SequenceStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  /// Copia de `stepId` con un valor centinela para el envío inicial.
  ///
  /// Existe sólo para la restricción de unicidad: tanto SQLite como PostgreSQL
  /// consideran distintos dos NULL en un índice único, así que una columna
  /// nullable no impediría encolar dos veces el mismo envío inicial.
  stepKey String @default("initial")

  /// Envío inicial del que cuelga este seguimiento. Nulo en el propio inicial.
  rootId String?
  root   Recipient?  @relation("SeguimientoDe", fields: [rootId], references: [id], onDelete: Cascade)
  follow Recipient[] @relation("SeguimientoDe")

  /// Momento a partir del cual puede enviarse. Nulo = en cuanto le toque.
  /// Los seguimientos lo usan para respetar su espera.
  availableAt DateTime?

  // PENDING | SENDING | SENT | FAILED | SKIPPED
  status   String  @default("PENDING")
  attempts Int     @default(0)
  error    String?

  // Identificador opaco que viaja en el píxel y en los enlaces rastreados
  trackingId String @unique @default(cuid())

  /// Remitente que envió este correo. Con varios en una campaña, es lo que
  /// permite atribuir cada envío a su cuota — y lo que hace que los
  /// seguimientos salgan del mismo remitente que el primer mensaje.
  senderId String?

  gmailMessageId String?
  gmailThreadId  String?

  sentAt         DateTime?
  firstOpenedAt  DateTime?
  lastOpenedAt   DateTime?
  openCount      Int       @default(0)
  firstClickedAt DateTime?
  clickCount     Int       @default(0)
  unsubscribedAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sender   Sender?  @relation(fields: [senderId], references: [id], onDelete: SetNull)
  events   Event[]

  @@unique([campaignId, contactId, stepKey])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([stepId])
  @@index([rootId])
}

// ---------------------------------------------------------------------------
// Secuencias de seguimiento
// ---------------------------------------------------------------------------

/// Un correo de seguimiento que sale automáticamente unos días después del
/// envío inicial, sólo a quien cumpla la condición.
///
/// La condición se evalúa siempre contra el **envío inicial**, no contra el
/// seguimiento anterior: es lo que la gente espera al escribir «a quien no haya
/// abierto», y evita cadenas de condiciones difíciles de razonar.
model SequenceStep {
  id         String @id @default(cuid())
  campaignId String

  /// Orden dentro de la secuencia, empezando en 1.
  position Int

  /// Espera desde el envío inicial, en horas.
  delayHours Int @default(72)

  /// ALWAYS | NO_OPEN | NO_CLICK (ver SEQUENCE_CONDITION en lib/constants.ts).
  condition String @default("NO_OPEN")

  /// Asunto propio; vacío = responder en el mismo hilo conservando el asunto.
  subject String @default("")
  html    String @default("")

  /// Remitente propio. Nulo = el mismo que envió el mensaje inicial a ese
  /// contacto, que es lo que mantiene la conversación coherente.
  senderId String?
  sender   Sender? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipients Recipient[]

  @@unique([campaignId, position])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Seguimiento y auditoría
// ---------------------------------------------------------------------------

model Event {
  id String @id @default(cuid())

  // SENT | OPEN | CLICK | UNSUBSCRIBE | BOUNCE | FAILED
  type String

  campaignId  String?
  contactId   String?
  recipientId String?

  url       String?
  userAgent String?
  ipHash    String?
  meta      String?

  createdAt DateTime @default(now())

  campaign  Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  recipient Recipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([campaignId, type])
}

/// Consumo de cuota en cubos de una hora (UTC).
///
/// Los proveedores aplican sus límites sobre una **ventana móvil de 24 horas**,
/// no sobre el día natural: si se envían 2.000 correos a las 23:00, a medianoche
/// no se libera nada. Guardar cubos horarios permite sumar exactamente las
/// últimas 24 horas y sobrevive al borrado de lo que originó los envíos.
///
/// La clave no es el remitente sino el **sujeto de la cuota**, porque no
/// coinciden: dos alias de la misma cuenta de Google son dos remitentes pero
/// comparten un único límite de 2.000, y todos los remitentes de Resend comparten
/// el plan del equipo. Ver `quotaKeyFor` en lib/quota.ts.
model SendLog {
  id       String @id @default(cuid())
  quotaKey String
  hour     String // YYYY-MM-DDTHH en UTC

  count Int @default(0)

  @@unique([quotaKey, hour])
  @@index([quotaKey, hour])
}

model ImportJob {
  id       String  @id @default(cuid())
  filename String
  userId   String?

  totalRows Int @default(0)
  imported  Int @default(0)
  updated   Int @default(0)
  skipped   Int @default(0)
  invalid   Int @default(0)

  // PENDING | DONE | FAILED
  status  String @default("DONE")
  errors  String @default("[]")
  listIds String @default("[]")

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
