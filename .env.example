# ---------------------------------------------------------------------------
# Eture Mailer — variables de entorno
# Copia este fichero a .env y rellena los valores.
# ---------------------------------------------------------------------------

# URL pública de la aplicación. Se usa para el callback de OAuth y para
# construir los enlaces de seguimiento (píxel de apertura, clics, baja).
# En producción DEBE ser https y accesible desde internet, o el tracking
# y los enlaces de baja no funcionarán en el correo del destinatario.
APP_URL="http://localhost:3000"

# --- Base de datos ---------------------------------------------------------
# SQLite por defecto (no requiere instalar nada).
DATABASE_URL="file:./dev.db"
# Para PostgreSQL: cambia el provider en prisma/schema.prisma y usa, p. ej.
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/eture_mailer?schema=public"

# --- Google OAuth (Google Cloud Console) -----------------------------------
# 1. https://console.cloud.google.com/ → crea un proyecto
# 2. APIs y servicios → Biblioteca → habilita "Gmail API"
# 3. Pantalla de consentimiento OAuth → tipo "Interno" (Google Workspace)
# 4. Credenciales → Crear credenciales → ID de cliente de OAuth → Aplicación web
#    URI de redireccionamiento autorizado: {APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Seguridad -------------------------------------------------------------
# Clave para firmar la cookie de sesión. Genera una con:
#   openssl rand -base64 32
SESSION_SECRET=""

# Clave para cifrar en base de datos los tokens OAuth de Gmail (AES-256-GCM).
# Genera una distinta de la anterior con:
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Control de acceso -----------------------------------------------------
# Dominios de Google Workspace autorizados a entrar, separados por comas.
# Déjalo vacío para permitir cualquier cuenta de Google (no recomendado).
ALLOWED_DOMAINS="eturesports.com"

# Correos concretos autorizados aunque su dominio no esté en la lista.
ALLOWED_EMAILS=""

# El primer usuario que entre se convierte en OWNER automáticamente. Si
# prefieres fijarlo, indica aquí su correo.
OWNER_EMAIL=""

# --- Envío -----------------------------------------------------------------
# Zona horaria usada para el corte de cuota diaria y la programación.
TIMEZONE="Europe/Madrid"

# Token que protege el endpoint /api/cron (procesa la cola de envío).
# Genera uno con: openssl rand -hex 24
CRON_SECRET=""

# Cuántos correos como máximo procesa cada pasada del worker.
CRON_BATCH_SIZE="40"

# Misma zona horaria, accesible desde el navegador para formatear fechas en la
# interfaz. Debe coincidir con TIMEZONE.
NEXT_PUBLIC_TIMEZONE="Europe/Madrid"
